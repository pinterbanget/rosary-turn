{
  "name": "rosary-turn",
  "version": "0.1.3",
  "description": "Pray the Rosary while your coding agent works. Based on Quran Turn by Rizaldy.",
  "license": "MIT",
  "author": "Rizaldy (original Quran Turn)",
  "contributors": [
    {
      "name": "pinterbanget",
      "url": "https://github.com/pinterbanget"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinterbanget/rosary-turn.git"
  },
  "keywords": [
    "rosary",
    "openrosary",
    "claude-code",
    "codex",
    "hooks",
    "offline",
    "plugin"
  ],
  "type": "module",
  "bin": {
    "rosary-turn": "bin/rosary-turn"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/rosary-turn.test.mjs",
    "verify": "node scripts/verify.mjs",
    "start": "node bin/rosary-turn serve"
  },
  "files": [
    "bin/rosary-turn",
    "src",
    "app",
    "vendor/openrosary",
    "hooks",
    ".claude-plugin",
    ".codex-plugin",
    ".agents/plugins",
    "scripts/verify.mjs",
    "native",
    "CHANGELOG.md",
    "NOTICE.md",
    "PRODUCT.md",
    "DESIGN.md"
  ]
}
