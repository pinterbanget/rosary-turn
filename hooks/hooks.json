{
  "description": "Rosary Turn: open while the agent works, step aside when it needs you, save progress when done. Original session design by Rizaldy.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=commonjs -e \"import(require('node:url').pathToFileURL((process.env.PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT) + '/bin/rosary-turn').href)\" -- rosary-turn hook start",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=commonjs -e \"import(require('node:url').pathToFileURL((process.env.PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT) + '/bin/rosary-turn').href)\" -- rosary-turn hook needs-you",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=commonjs -e \"import(require('node:url').pathToFileURL((process.env.PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT) + '/bin/rosary-turn').href)\" -- rosary-turn hook resume",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=commonjs -e \"import(require('node:url').pathToFileURL((process.env.PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT) + '/bin/rosary-turn').href)\" -- rosary-turn hook stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
